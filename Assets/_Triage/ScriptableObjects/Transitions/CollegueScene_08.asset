  m_Name: CollegueScene_08
  m_EditorClassIdentifier: Assembly-CSharp::CollegueSceneData
  nomScenario: "\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\n\u2014
    SC\xC9NARIO 08 \xB7 LE DONNEUR ET LE RECEVEUR"
  dialogues:
  - nomPersonnage: "DR. MARTIN \u2014 CHEF ADJOINT"
    texte: "Le comit\xE9 d'\xE9thique a \xE9t\xE9 saisi. D\xE9roger \xE0 la liste
      de greffe, c'est un pr\xE9c\xE9dent s\xE9rieux."
    personnageIndex: 2
  - nomPersonnage: "KARIM B. \u2014 AIDE-SOIGNANT"
    texte: "Hassan attendait depuis huit mois. Sa famille \xE9tait l\xE0 ce soir."
    personnageIndex: 1
  - nomPersonnage: "SOPHIE M. \u2014 INFIRMI\xC8RE"
    texte: Claire a dix-sept ans. Je comprends le choix. Mais le protocole existe
      pour une raison.
    personnageIndex: 0
