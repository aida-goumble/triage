  nomScenario: "\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\n\u2014
    SC\xC9NARIO 07 \xB7 L'AVOCAT ET LA PLAINTE PR\xC9VENTIVE "
  dialogues:
  - nomPersonnage: "KARIM B. \u2014 AIDE-SOIGNANT"
    texte: Il y a une convocation de la direction sur le bureau. L'avocat a tenu
      sa promesse.
    personnageIndex: 1
  - nomPersonnage: "SOPHIE M. \u2014 INFIRMI\xC8RE"
    texte: "Nadia est stabilis\xE9e. Elle nous a remerci\xE9s trois fois en partant."
    personnageIndex: 0
  - nomPersonnage: "DR. MARTIN \u2014 CHEF ADJOINT"
    texte: "Aucun juge ne condamne une d\xE9cision m\xE9dicale document\xE9e. Il
      a bien fait."
    personnageIndex: 2
