  nomScenario: "\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\n\u2014
    SC\xC9NARIO 06 \xB7LE PR\xC9MATUR\xC9 ET LA JEUNE FEMME"
  dialogues:
  - nomPersonnage: "SOPHIE M. \u2014 INFIRMI\xC8RE"
    texte: "Il a tout tent\xE9 pour lui. Amina a attendu trop longtemps."
    personnageIndex: 0
  - nomPersonnage: "DR. MARTIN \u2014 CHEF ADJOINT"
    texte: "Amina \xE9tait stabilisable rapidement. Ce choix va \xEAtre difficile
      \xE0 justifier."
    personnageIndex: 2
  - nomPersonnage: "KARIM B. \u2014 AIDE-SOIGNANT"
    texte: "Une vie qui commence contre une qui avait tout devant elle. Il n'y avait
      pas de bonne r\xE9ponse."
    personnageIndex: 1
