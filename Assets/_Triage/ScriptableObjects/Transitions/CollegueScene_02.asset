  nomScenario: "\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\n\u2014
    SC\xC9NARIO 02 \xB7 L'ENFANT ET LE PERE DE FAMILLE"
  dialogues:
  - nomPersonnage: "SOPHIE M. \u2014 INFIRMI\xC8RE"
    texte: Un enfant de 8 ans... il n'avait pas le choix, si ?
    personnageIndex: 0
  - nomPersonnage: "DR. MARTIN \u2014 CHEF ADJOINT"
    texte: "Le pronostic de Martin n'\xE9tait pas gr\xE2ve. Sa famille risque de
      porter plainte."
    personnageIndex: 2
  - nomPersonnage: "KARIM B. \u2014 AIDE-SOIGNANT"
    texte: "Les deux \xE9taient critiques. Il n'y avait pas de bonne r\xE9ponse."
    personnageIndex: 1
