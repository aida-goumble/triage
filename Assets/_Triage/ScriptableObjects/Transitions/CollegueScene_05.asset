  nomScenario: "\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\n\u2014
    SC\xC9NARIO 05 \xB7 LE CHIRURGIEN ET SON FILS"
  dialogues:
  - nomPersonnage: "KARIM B. \u2014 AIDE-SOIGNANT"
    texte: "Le Dr. Auriac n'a pas adress\xE9 la parole \xE0 personne de la soir\xE9e."
    personnageIndex: 1
  - nomPersonnage: "DR. MARTIN \u2014 CHEF ADJOINT"
    texte: "Fatima est tir\xE9e d'affaire. C'\xE9tait la seule d\xE9cision m\xE9dicalement
      d\xE9fendable."
    personnageIndex: 2
  - nomPersonnage: "SOPHIE M. \u2014 INFIRMI\xC8RE"
    texte: "Auriac va lui rendre la vie difficile. Mais l'\xE9quipe sait ce qu'il
      a fait."
    personnageIndex: 0
