  nomScenario: "\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\n\u2014
    SC\xC9NARIO 01 \xB7 LE MAIRE ET LE VIEUX MONSIEUR"
  dialogues:
  - nomPersonnage: "SOPHIE M. \u2014 INFIRMI\xC8RE"
    texte: "T'as vu ce qu'il a fait ? Il a ignor\xE9 le maire..."
    personnageIndex: 0
  - nomPersonnage: "DR. MARTIN \u2014 CHEF ADJOINT"
    texte: "Moi je dis qu'il a eu raison. Le vieux \xE9tait critique."
    personnageIndex: 2
  - nomPersonnage: "KARIM B. \u2014 AIDE-SOIGNANT"
    texte: "J'imagine... mais \xE7a va nous retomber dessus."
    personnageIndex: 1
