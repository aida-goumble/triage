  nomScenario: "\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\n\u2014
    SC\xC9NARIO 03 \xB7 L'INFIRMI\xC8RE ET LE SANS-ABRI"
  dialogues:
  - nomPersonnage: "SOPHIE M. \u2014 INFIRMI\xC8RE"
    texte: Il a pris le sans-abri en premier. L'autre attendait depuis vingt minutes.
    personnageIndex: 0
  - nomPersonnage: "DR. MARTIN \u2014 CHEF ADJOINT"
    texte: "C'\xE9tait le 1er arriv\xE9. Protocole respect\xE9. Point final."
    personnageIndex: 2
  - nomPersonnage: "KARIM B. \u2014 AIDE-SOIGNANT"
    texte: "L'infirmi\xE8re senior n'a pas d\xE9chant\xE9. \xC7a va faire des vagues
      en interne."
    personnageIndex: 1
